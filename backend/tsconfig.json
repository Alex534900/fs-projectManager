{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",

    "module": "commonjs",
    "target": "esnext",

    "types": [
      "node",
      "vitest/globals"
    ],

    "sourceMap": true,
    "declaration": true,

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },

  "include": [
    "src",
    "prisma",
    "vitest.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}